# Exemplo para Nginx instalado diretamente na VPS.
# Não aplique se Traefik, Nginx Proxy Manager, Apache ou outro proxy já atender o domínio.
server {
    listen 80;
    server_name institutoacesso.org.br www.institutoacesso.org.br;
    location / {
        proxy_pass http://127.0.0.1:18085;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
